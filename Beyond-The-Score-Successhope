function sceneNow(p){return scenes[game.round];}
function choicesFor(p){let raw=sceneNow(p).choices;return typeof raw==='function'?raw(p):raw;}
function record(p,title,text,kind='choice'){p.journal.push({age:scenes[game.round]?.age??75,step:game.round,title,text,kind});}
function skillChange(p,mod){for(const [k,v] of Object.entries(mod||{}))if(k in p.skills)p.skills[k]=clamp(p.skills[k]+v);}

function apply(p,delta={}){
  const tracked=['cash','debt','energy','bonds','options','stress','belonging','purpose','recognition'];
  const was=Object.fromEntries(tracked.map(k=>[k,Number(p[k]||0)]));
  const oldSkills={...p.skills};
  if(delta.repay){const paid=Math.max(0,Math.min(p.cash,p.debt,delta.repay));p.cash-=paid;p.debt-=paid;}
  if(typeof delta.cash==='number'){
    p.cash+=delta.cash;
    if(p.cash<0){const short=-p.cash;p.cash=0;if(scenes[game.round]?.age>=18)p.debt+=short;else p.options=clamp(p.options-1);}
  }
  if(typeof delta.debt==='number')p.debt=Math.max(0,p.debt+delta.debt);
  for(const k of ['energy','bonds','options','stress','belonging','purpose','recognition'])if(typeof delta[k]==='number')p[k]=clamp(Number(p[k]||0)+delta[k]);
  skillChange(p,delta.skills);
  let dif={};for(const k of tracked)if(was[k]!==p[k])dif[k]=p[k]-was[k];
  for(const [k,v] of Object.entries(p.skills))if(v!==oldSkills[k])dif['skill_'+k]=v-oldSkills[k];
  return dif;
}
function asText(delta){const o=Object.entries(delta||{});if(!o.length)return 'No additional tracked change';return o.map(([k,v])=>`${v>0?'+':''}${k==='cash'||k==='debt'?usd(v):v+' '+(k.startsWith('skill_')?k.slice(6)+' practice':k)}`).join(', ');}
function updateCareer(p,next,reason='Career decision'){
 const previous=p.career;
 if(previous===next)return;
 if(!Array.isArray(p.careerHistory))p.careerHistory=[];
 const age=scenes[game.round]?.age??75;
 if(previous==='athlete'&&next!=='athlete'){
   p.flags.pro=false;
   p.flags.proEndAge=age;
 }
 if(next==='athlete'){
   p.flags.pro=true;
   p.flags.everPro=true;
   if(p.flags.proStartAge==null)p.flags.proStartAge=age;
 }
 p.career=next;
 p.careerHistory.push({age,previous,next,reason});
}

function setVars(p,data={}){
 for(const [k,v] of Object.entries(data)){
  if(k==='sport'){p.sport=v;p.flags.playedSport=!!v;}
  else if(k==='career')updateCareer(p,v,'Player selected a new professional path');
  else if(k==='closeVenture'&&v){p.venture=null;p.flags.businessClosed=true;if(p.career==='founder')updateCareer(p,'freelance','Business closed; independent work begins');}
  else if(['route','major','program','interest'].includes(k))p[k]=v;
  else p.flags[k]=v;
 }
}

function odds(p,kind){
 let favorable=clamp(27+Math.round((p.options-5)*1.4+(p.bonds-5)*.5)-(p.background.friction-2)*2+(p.flags.mentor?3:0),13,46);
 let difficult=clamp(26+(p.energy<4?5:0)+(p.background.pressure-2)*1.3+(p.background.friction-2)*1.8-(p.bonds>7?2:0),16,46);
 if(kind==='emotions'||kind==='social'||kind==='party'){
   favorable=clamp(favorable+(p.belonging-5)*.7-(p.stress-5)*.8,10,50);
   difficult=clamp(difficult+(p.stress-5)*1.2-(p.belonging-5)*.5,12,55);
 }
 if(kind==='ambition'||kind==='business'){
   favorable=clamp(favorable+(p.skills.business-3)*.9+(p.recognition-4)*.55,9,52);
   difficult=clamp(difficult+(p.stress-5)*.9,11,53);
 }
 favorable=Math.round(favorable);difficult=Math.round(difficult);
 if(favorable+difficult>83)difficult=83-favorable;
 return {favorable,difficult,ordinary:100-favorable-difficult};
}
