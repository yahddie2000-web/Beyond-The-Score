function chanceResult(p,scene,option,preOdds){
 if(option.special)return specialResult(p,option.special);
 const roll=1+rng(100);
 const band=roll<=preOdds.favorable?'good':roll<=preOdds.favorable+preOdds.ordinary?'neutral':'bad';
 const deck=chanceDeck[scene.kind]||chanceDeck.general;
 const possibles=variantDeck[scene.kind]?.[band]||[];
 const [title,text,delta]=possibles.length&&rng(100)<53?possibles[rng(possibles.length)]:deck[band];
 const changes=apply(p,delta);
 return {kind:'general',roll,title,text,changes,band,odds:preOdds};
}

function validSave(x){
 return x&&[5,6].includes(x.version)&&x.game&&['play','finish'].includes(x.game.screen)&&Array.isArray(x.game.players)&&x.game.players.length>=1&&x.game.players.length<=4&&Number.isInteger(x.game.round)&&x.game.round>=0&&x.game.round<=(x.version===5?baseScenes.length:scenes.length)&&Number.isInteger(x.game.current)&&x.game.current>=0&&x.game.current<x.game.players.length&&['decision','spin','result'].includes(x.game.phase)&&x.game.players.every(p=>typeof p.name==='string'&&p.name.length<100&&typeof p.cash==='number'&&typeof p.debt==='number'&&p.background&&typeof p.background.id==='string'&&Array.isArray(p.journal)&&Array.isArray(p.pending)&&p.skills&&p.flags&&typeof p.energy==='number');
}
function persist(){if(game.screen==='setup')return;try{localStorage.setItem(SAVE_KEY,JSON.stringify({version:6,game,prefs}));saveSupported=true;}catch(e){saveSupported=false;}}

function restore(saved){
 if(!validSave(saved))return false;
 // Migrate a V5 game to equivalent existing chapter in V6. Newly inserted earlier scenes are skipped.
 if(saved.version===5){
   const translate=i=>i>=baseScenes.length?scenes.length:(oldSceneMap[i]??scenes.length);
   const x=saved.game;
   x.round=translate(x.round);
   for(const p of x.players){
     p.visited=(p.visited||[]).map(translate);
     p.pending=(p.pending||[]).map(d=>({...d,due:translate(d.due)}));
     (p.journal||[]).forEach(j=>{if(Number.isInteger(j.step))j.step=translate(j.step)});
     (p.chanceHistory||[]).forEach(j=>{if(Number.isInteger(j.step))j.step=translate(j.step)});
   }
   saved.version=6;
 }
 game=saved.game;
 for(const p of game.players){
   if(!Array.isArray(p.careerHistory))p.careerHistory=[];
   if(!Array.isArray(p.feelingsLog))p.feelingsLog=[];
   if(!Array.isArray(p.visited))p.visited=[];
   if(p.flags.pro&&p.career==='athlete')p.flags.everPro=true;
   p.stress=Number.isFinite(p.stress)?clamp(p.stress):clamp(p.background.pressure+2);
   p.belonging=Number.isFinite(p.belonging)?clamp(p.belonging):clamp(p.bonds);
   p.purpose=Number.isFinite(p.purpose)?clamp(p.purpose):5;
   p.recognition=Number.isFinite(p.recognition)?clamp(p.recognition):2;
   if(!p.flags.lastIncomeAge&&p.visited.length){
     const agesSeen=p.visited.map(i=>scenes[i]?.age).filter(age=>age>=23);
     if(agesSeen.length)p.flags.lastIncomeAge=Math.max(...agesSeen);
   }
 }
 prefs=Array.isArray(saved.prefs)&&saved.prefs.length===game.players.length?saved.prefs:game.players.map(p=>({name:p.name,background:p.background.id,home:p.home.id,priority:p.priority}));
 return true;
}

function restoreAuto(){
 try{
  const newSave=localStorage.getItem(SAVE_KEY);
  if(newSave)return restore(JSON.parse(newSave));
  // Do not automatically import old games: a new V6 player should see the expanded childhood story.
  // Older V5 JSON backups are still supported through the Load Saved Game control.
  return false;
 }catch(e){saveSupported=false;return false;}
}
