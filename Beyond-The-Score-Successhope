function chanceResult(p,scene,option,preOdds){
 if(option.special)return specialResult(p,option.special);
 const roll=1+rng(100);
 const band=roll<=preOdds.favorable?'good':roll<=preOdds.favorable+preOdds.ordinary?'neutral':'bad';
 const deck=chanceDeck[scene.kind]||chanceDeck.general;
 const possibles=variantDeck[scene.kind]?.[band]||[];
 const [title,text,delta]=possibles.length&&rng(100)<53?possibles[rng(possibles.length)]:deck[band];
 const changes=apply(p,delta);
 return {kind:'general',roll,title,text,changes,band,odds:preOdds};
}

function validSave(x){
