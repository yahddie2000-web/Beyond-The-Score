 }
}

function odds(p,kind){
 let favorable=clamp(27+Math.round((p.options-5)*1.4+(p.bonds-5)*.5)-(p.background.friction-2)*2+(p.flags.mentor?3:0),13,46);
 let difficult=clamp(26+(p.energy<4?5:0)+(p.background.pressure-2)*1.3+(p.background.friction-2)*1.8-(p.bonds>7?2:0),16,46);
 if(kind==='emotions'||kind==='social'||kind==='party'){
   favorable=clamp(favorable+(p.belonging-5)*.7-(p.stress-5)*.8,10,50);
   difficult=clamp(difficult+(p.stress-5)*1.2-(p.belonging-5)*.5,12,55);
 }
 if(kind==='ambition'||kind==='business'){
   favorable=clamp(favorable+(p.skills.business-3)*.9+(p.recognition-4)*.55,9,52);
   difficult=clamp(difficult+(p.stress-5)*.9,11,53);
 }
 favorable=Math.round(favorable);difficult=Math.round(difficult);
 if(favorable+difficult>83)difficult=83-favorable;
 return {favorable,difficult,ordinary:100-favorable-difficult};
}
